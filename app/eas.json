{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.13.0",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://timemap-backend-mki9.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}